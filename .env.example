EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Enable only after eBay grants the buy.marketplace.insights scope.
EBAY_MARKETPLACE_INSIGHTS_ENABLED=false

# Zero-cost private-alpha path while eBay Marketplace Insights remains restricted.
MARKET_SOLD_PROVIDER=sold_comps
SOLD_COMPS_API_KEY=
SOLD_COMPS_EBAY_SITE=ebay.com
# Three grouped searches per day stays near the advertised free monthly allowance.
SOLD_COMPS_MAX_QUERIES_PER_RUN=3

# Optional paid multi-market path. Persistent ingestion is allowed only on a
# paid plan under The Card API terms.
THE_CARD_API_KEY=
THE_CARD_API_PLAN=starter
THE_CARD_API_PLATFORMS=ebay
# Goldin reports hammer prices. Leave Goldin disabled unless a reviewed buyer
# premium is configured, e.g. THE_CARD_API_PLATFORMS=ebay,goldin.
THE_CARD_API_GOLDIN_BUYER_PREMIUM=
